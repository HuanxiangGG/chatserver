# Merge only this site block into your existing Caddyfile. Do not replace other sites.
{$CHAT_DOMAIN:chat.6hx9.com} {
    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        # Origin is passed through unchanged. Never forge a trusted Origin here.
    }
}
