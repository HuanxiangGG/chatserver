[Unit]
Description=Harbor private database and uploads backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
# Replace with the EXISTING production checkout and Compose configuration.
WorkingDirectory=/opt/chatserver
Environment=COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
Environment=BACKUP_DIR=/var/backups/harbor
Environment=BACKUP_RETENTION_DAYS=14
Environment=BACKUP_MIN_FREE_MB=1024
UMask=0077
ExecStart=/opt/chatserver/scripts/backup.sh
TimeoutStartSec=2h
