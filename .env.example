# Copy this file to .env; never commit .env. Generate random hex values below.
POSTGRES_USER=harbor
POSTGRES_DB=harbor
POSTGRES_PASSWORD=CHANGE_ME_WITH_RANDOM_HEX
REDIS_PASSWORD=CHANGE_ME_WITH_ANOTHER_RANDOM_HEX
# Used by local npm processes. Compose builds its own internal URLs.
DATABASE_URL=postgresql://harbor:CHANGE_ME_WITH_RANDOM_HEX@localhost:5432/harbor
REDIS_URL=redis://:CHANGE_ME_WITH_ANOTHER_RANDOM_HEX@localhost:6379/0
APP_ORIGIN=https://chat.6hx9.com
COOKIE_SECURE=true
TRUST_PROXY=1
PORT=3000
UPLOAD_DIR=./uploads
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# HTTPS override: set APP_ORIGIN=https://chat.example.com, COOKIE_SECURE=true,
# HTTP_BIND=0.0.0.0, HTTP_PORT=80, DOMAIN=chat.example.com
DOMAIN=chat.example.com
