generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String               @id @default(cuid())
  username         String               @unique
  email            String               @unique
  passwordHash     String
  displayName      String
  avatarUrl        String?
  bio              String               @default("")
  role             String               @default("USER")
  status           String               @default("OFFLINE")
  banned           Boolean              @default(false)
  bannedUntil      DateTime?
  banReason        String               @default("")
  banActorId       String?
  reports          Report[]             @relation("Reporter")
  handledReports   Report[]             @relation("ReportHandler")
  lastSeenAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  announcements    GroupAnnouncement[]
  announcementReads GroupAnnouncementRead[]
  groupMutesIssued GroupMute[]
  forwardBatches   ForwardBatch[]
  preference       UserPreference?
  sessions         Session[]
  friendships      Friendship[]         @relation("FriendshipUser")
  friends          Friendship[]         @relation("FriendshipFriend")
  sentRequests     FriendRequest[]      @relation("RequestFrom")
  receivedRequests FriendRequest[]      @relation("RequestTo")
  memberships      ConversationMember[]
  messages         Message[]
  attachments      MessageAttachment[]
  reads            MessageRead[]
  hidden           MessageHidden[]
  blocks           BlockedUser[]        @relation("Blocker")
  blockedBy        BlockedUser[]        @relation("Blocked")
  adminActions     AdminAction[]
  resets           PasswordReset[]
  communities      ServerMember[]
  ownedServers     Server[]             @relation("ServerOwner")
  channelGrants    ChannelGrant[]
  serverBans       ServerBan[]
  serverRoles      ServerRoleMember[]
  botIdentity      Bot?
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  csrfToken String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Friendship {
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
}

model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  from      User     @relation("RequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("RequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId, status])
}

model Conversation {
  id          String               @id @default(cuid())
  type        String
  directKey   String?              @unique
  name        String?
  avatarUrl   String?
  description String               @default("")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     ConversationMember[]
  messages    Message[]
  announcements GroupAnnouncement[]
  channel     Channel?
  ticket      Ticket?
}

model ConversationMember {
  conversationId  String
  userId          String
  role            String       @default("MEMBER")
  joinedAt        DateTime     @default(now())
  lastReadAt      DateTime     @default(now())
  lastDeliveredAt DateTime     @default(now())
  mute            GroupMute?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String?
  guestTicketId  String?
  content        String              @default("")
  clientId       String
  forwardedFrom  Json?
  replyToId      String?
  createdAt      DateTime            @default(now())
  editedAt       DateTime?
  retractedAt    DateTime?
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  guestTicket    Ticket?             @relation("GuestMessages", fields: [guestTicketId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sender         User?               @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo        Message?            @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]           @relation("Replies")
  attachments    MessageAttachment[]
  reads          MessageRead[]
  hidden         MessageHidden[]

  @@unique([senderId, clientId])
  @@unique([guestTicketId, clientId])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, senderId, createdAt, id])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_content_trgm_idx")
}

model MessageAttachment {
  id         String   @id @default(cuid())
  ownerId    String?
  guestTicketId String?
  guestTicket Ticket? @relation("GuestAttachments", fields: [guestTicketId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "Attachment_guestTicketId_fkey")
  messageId  String?
  filename   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model MessageRead {
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MessageHidden {
  messageId String
  userId    String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model BlockedUser {
  userId    String
  blockedId String
  createdAt DateTime @default(now())
  user      User     @relation("Blocker", fields: [userId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([userId, blockedId])
}

model AdminAction {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Server {
  id          String            @id @default(cuid())
  ownerId     String
  name        String
  description String            @default("")
  privateTicketsEnabled Boolean @default(true)
  guestTicketsEnabled Boolean @default(false)
  rules       String            @default("")
  iconUrl     String?
  createdAt   DateTime          @default(now())
  owner       User              @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ServerMember[]
  categories  ChannelCategory[]
  channels    Channel[]
  invites     ServerInvite[]
  bans        ServerBan[]
  roles       ServerRole[]
  tickets     Ticket[]
  installations BotInstallation[]
}

model ServerMember {
  serverId   String
  userId     String
  role       String    @default("MEMBER")
  mutedUntil DateTime?
  joinedAt   DateTime  @default(now())
  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([serverId, userId])
  @@index([userId])
}

model ServerBan {
  serverId  String
  userId    String
  reason    String
  createdAt DateTime @default(now())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([serverId, userId])
}

model ChannelCategory {
  id       String    @id @default(cuid())
  serverId String
  name     String
  position Int       @default(0)
  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]

  @@index([serverId, position])
}

model Channel {
  id             String           @id @default(cuid())
  serverId       String
  conversationId String           @unique
  categoryId     String?
  position       Int              @default(0)
  isPrivate      Boolean          @default(false)
  readOnly       Boolean          @default(false)
  archivedAt     DateTime?
  server         Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  category       ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  grants         ChannelGrant[]
  permissionOverrides Json?
  roleOverrides ChannelRoleOverride[]
  restrictions ChannelRestriction[]

  @@index([serverId, archivedAt, position])
}

model ChannelGrant {
  channelId String
  userId    String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
}

model ServerInvite {
  id        String    @id @default(cuid())
  serverId  String
  tokenHash String    @unique
  expiresAt DateTime
  maxUses   Int
  uses      Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

model UserPreference {
  userId String @id
  sound Json
  appearance Json?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ForwardBatch {
  id String @id @default(cuid())
  userId String
  clientId String
  payloadHash String
  messageIds Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientId])
}

model GroupAnnouncement {
  id String @id @default(cuid())
  conversationId String
  authorId String
  title String
  content String
  pinned Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  reads GroupAnnouncementRead[]
  @@index([conversationId, deletedAt, pinned, createdAt])
}
model GroupAnnouncementRead {
  announcementId String
  userId String
  version Int
  readAt DateTime @default(now())
  announcement GroupAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([announcementId, userId])
}
model GroupMute {
  conversationId String
  userId String
  actorId String
  reason String
  until DateTime?
  permanent Boolean @default(false)
  updatedAt DateTime @updatedAt
  member ConversationMember @relation(fields: [conversationId, userId], references: [conversationId, userId], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@id([conversationId, userId])
}

model Report {
  id String @id @default(cuid())
  reporterId String
  targetType String
  targetId String
  reason String
  details String
  status String @default("OPEN")
  handlerId String?
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handler User? @relation("ReportHandler", fields: [handlerId], references: [id], onDelete: SetNull)
  @@index([status, createdAt, id])
  @@index([reporterId, createdAt])
}

// Community-scoped roles never confer global administrator privileges.
model ServerRole {
  id String @id @default(cuid())
  serverId String
  name String
  position Int @default(10)
  permissions Json
  createdAt DateTime @default(now())
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members ServerRoleMember[]
  channels ChannelRoleOverride[]
  @@index([serverId, position])
}
model ServerRoleMember {
  roleId String
  userId String
  role ServerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([roleId, userId])
  @@index([userId])
}
model ChannelRoleOverride {
  channelId String
  roleId String
  permissions Json
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role ServerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([channelId, roleId])
}
model Ticket {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  serverId String
  conversationId String @unique
  memberId String?
  guestName String?
  recoveryHash String?
  guestSessions GuestTicketSession[]
  guestMessages Message[] @relation("GuestMessages")
  guestAttachments MessageAttachment[] @relation("GuestAttachments")
  creatorId String
  assigneeId String?
  subject String
  category String
  status String @default("OPEN")
  clientId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  server Server @relation(fields: [serverId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  @@unique([creatorId, clientId])
  @@index([serverId, status, createdAt])
  @@index([memberId, createdAt])
}
model Bot {
  id String @id @default(cuid())
  developerId String
  userId String @unique
  name String
  tokenHash String @unique
  builtin Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  installations BotInstallation[]
}
model BotInstallation {
  id String @id @default(cuid())
  botId String
  serverId String
  enabled Boolean @default(true)
  channelIds Json
  permissions Json
  config Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  welcomes BotWelcome[]
  events BotEvent[]
  @@unique([botId, serverId])
}
model BotWelcome {
  installationId String
  userId String
  installation BotInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  @@id([installationId, userId])
}
model BotEvent {
  id String @id @default(cuid())
  installationId String
  type String
  payload Json
  createdAt DateTime @default(now())
  installation BotInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  @@index([installationId, createdAt, id])
}

model GuestTicketSession {
  id String @id @default(cuid())
  ticketId String
  tokenHash String @unique
  csrfToken String
  expiresAt DateTime
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([ticketId, expiresAt])
}
model ChannelRestriction {
  channelId String
  userId String
  actorId String
  reason String
  until DateTime?
  createdAt DateTime @default(now())
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([channelId, userId])
  @@index([userId, until])
}
